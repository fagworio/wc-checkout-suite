{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["ES2020", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": [ "jest" ]
	},
	"include": [
		"resources/**/*.js",
		"resources/**/*.ts",
		"resources/**/*.d.ts",
		"tests/js/**/*.js"
	],
	"exclude": ["node_modules", "vendor", "build"]
}
