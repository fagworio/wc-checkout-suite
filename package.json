{
	"name": "wc-checkoutsuite",
	"version": "1.0.0-rc.1",
	"description": "Advanced checkout field management for WooCommerce.",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.19.2"
	},
	"scripts": {
		"build": "npm run build:admin && npm run build:checkout && npm run build:blocks",
		"build:admin": "wp-scripts build --webpack-src-dir=resources/admin --output-path=build/admin",
		"build:checkout": "wp-scripts build --webpack-src-dir=resources/checkout --output-path=build/checkout",
		"start": "npm run start:admin",
		"start:admin": "wp-scripts start --webpack-src-dir=resources/admin --output-path=build/admin",
		"start:checkout": "wp-scripts start --webpack-src-dir=resources/checkout --output-path=build/checkout",
		"lint:js": "wp-scripts lint-js resources tests/js",
		"lint:js:fix": "wp-scripts lint-js resources tests/js --fix",
		"test:unit-js": "jest",
		"check-types": "tsc --noEmit",
		"format": "wp-scripts format resources tests/js",
		"build:blocks": "wp-scripts build --webpack-src-dir=resources/blocks --output-path=build/blocks",
		"test:e2e:woocommerce": "node tests/browser/full-woocommerce-flow.mjs",
		"test:e2e:admin-editor": "node tests/browser/admin-section-field-rules-flow.mjs",
		"test:e2e:my-account": "node tests/browser/my-account-sections-flow.mjs",
		"test:e2e:design": "node tests/browser/design-destinations-flow.mjs",
		"test:e2e:account-file": "node tests/browser/customer-account-file-field-flow.mjs"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/jest": "^30.0.0",
		"@types/react": "^19.3.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/scripts": "^35.0.0"
	},
	"dependencies": {
		"imask": "7.6.1"
	}
}
