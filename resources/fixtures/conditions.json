{
	"artifact": "conditions.json",
	"artifact_version": 1,
	"task": "WCCS-033",
	"purpose": "Cases the PHP and the JavaScript condition engines both answer, so a divergence shows up as a failing assertion on one side rather than as two stores behaving differently.",
	"vocabulary": {
		"note": "The operators and sources here are the ones GET /field-types publishes. They are copied so this file can be read without a running store; docs/validation/WCCS-033.md records that the catalogue is asserted to publish exactly these keys.",
		"operators": [
			"equals",
			"not_equals",
			"contains",
			"not_contains",
			"greater_than",
			"less_than",
			"is_empty",
			"is_not_empty",
			"in",
			"not_in"
		],
		"sources": [
			"field",
			"country",
			"state",
			"shipping_method",
			"payment_method",
			"customer_logged_in",
			"cart_items",
			"cart_categories",
			"cart_tags",
			"cart_total",
			"cart_virtual",
			"cart_downloadable",
			"cart_quantity",
			"cart_subtotal",
			"user_role"
		]
	},
	"cases": [
		{
			"group": "empty",
			"name": "an absent entry is empty",
			"note": "A source the context does not carry reads as absent, not as false.",
			"tree": {
				"source": "country",
				"operator": "is_empty"
			},
			"context": {},
			"expect": true
		},
		{
			"group": "empty",
			"name": "an empty string is empty",
			"tree": {
				"source": "state",
				"operator": "is_empty"
			},
			"context": {
				"state": ""
			},
			"expect": true
		},
		{
			"group": "empty",
			"name": "an empty list is empty",
			"tree": {
				"source": "cart_items",
				"operator": "is_empty"
			},
			"context": {
				"cart_items": []
			},
			"expect": true
		},
		{
			"group": "empty",
			"name": "absence negated is presence",
			"tree": {
				"source": "country",
				"operator": "is_not_empty"
			},
			"context": {},
			"expect": false
		},
		{
			"group": "empty",
			"name": "a list that was not submitted is empty",
			"tree": {
				"source": "cart_categories",
				"operator": "is_empty"
			},
			"context": {
				"cart_categories": []
			},
			"expect": true
		},
		{
			"group": "zero",
			"name": "a cart total of zero is a value",
			"note": "Empty is not falsy: zero is a total the customer has.",
			"tree": {
				"source": "cart_total",
				"operator": "is_empty"
			},
			"context": {
				"cart_total": 0
			},
			"expect": false
		},
		{
			"group": "zero",
			"name": "the text zero is a value",
			"tree": {
				"source": "cart_total",
				"operator": "is_empty"
			},
			"context": {
				"cart_total": "0"
			},
			"expect": false
		},
		{
			"group": "zero",
			"name": "zero equals the text zero",
			"tree": {
				"source": "cart_total",
				"operator": "equals",
				"value": "0"
			},
			"context": {
				"cart_total": 0
			},
			"expect": true
		},
		{
			"group": "zero",
			"name": "zero is not greater than zero",
			"tree": {
				"source": "cart_total",
				"operator": "greater_than",
				"value": 0
			},
			"context": {
				"cart_total": 0
			},
			"expect": false
		},
		{
			"group": "zero",
			"name": "zero is less than one",
			"tree": {
				"source": "cart_total",
				"operator": "less_than",
				"value": 1
			},
			"context": {
				"cart_total": "0"
			},
			"expect": true
		},
		{
			"group": "false",
			"name": "false is a value",
			"tree": {
				"source": "customer_logged_in",
				"operator": "is_empty"
			},
			"context": {
				"customer_logged_in": false
			},
			"expect": false
		},
