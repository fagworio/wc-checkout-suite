				"theme": "light",
				"foreground": "on_brand",
				"background": "brand_hover",
				"min": 4.5,
				"usage": "Primary button label on hover"
			},
			{
				"id": "light.button.on.danger",
				"theme": "light",
				"foreground": "on_brand",
				"background": "danger",
				"min": 4.5,
				"usage": "Destructive button label"
			},
			{
				"id": "light.success.on.surface",
				"theme": "light",
				"foreground": "success",
				"background": "surface",
				"min": 4.5,
				"usage": "Success message text, always paired with an icon or wording"
			},
			{
				"id": "light.warning.on.surface",
				"theme": "light",
				"foreground": "warning",
				"background": "surface",
				"min": 4.5,
				"usage": "Warning message text, always paired with an icon or wording"
			},
			{
				"id": "light.danger.on.surface",
				"theme": "light",
				"foreground": "danger",
				"background": "surface",
				"min": 4.5,
				"usage": "Field error text"
			},
			{
				"id": "light.control.boundary",
				"theme": "light",
				"foreground": "border_control",
				"background": "surface",
				"min": 3.0,
				"usage": "Input outline, which is what identifies the control"
			},
			{
				"id": "light.focus.indicator",
				"theme": "light",
				"foreground": "focus_ring",
				"background": "surface",
				"min": 3.0,
				"usage": "Focus outline against the surface"
			},
			{
				"id": "light.sidebar.text",
				"theme": "light",
				"foreground": "on_sidebar",
				"background": "sidebar_surface",
				"min": 4.5,
				"usage": "Sidebar navigation text, which sits on a dark surface in both themes"
			},
			{
