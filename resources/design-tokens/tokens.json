			},
			{
				"id": "dark.success.on.surface",
				"theme": "dark",
				"foreground": "success",
				"background": "surface",
				"min": 4.5,
				"usage": "Success message text, always paired with an icon or wording"
			},
			{
				"id": "dark.warning.on.surface",
				"theme": "dark",
				"foreground": "warning",
				"background": "surface",
				"min": 4.5,
				"usage": "Warning message text, always paired with an icon or wording"
			},
			{
				"id": "dark.danger.on.surface",
				"theme": "dark",
				"foreground": "danger",
				"background": "surface",
				"min": 4.5,
				"usage": "Field error text"
			},
			{
				"id": "dark.control.boundary",
				"theme": "dark",
				"foreground": "border_control",
				"background": "surface",
				"min": 3.0,
				"usage": "Input outline, which is what identifies the control"
			},
			{
				"id": "dark.focus.indicator",
				"theme": "dark",
				"foreground": "focus_ring",
				"background": "surface",
				"min": 3.0,
				"usage": "Focus outline against the surface"
			},
			{
				"id": "dark.sidebar.text",
				"theme": "dark",
				"foreground": "on_sidebar",
				"background": "sidebar_surface",
				"min": 4.5,
				"usage": "Sidebar navigation text, which sits on a dark surface in both themes"
			},
			{
				"id": "light.warning.on.warning_subtle",
				"theme": "light",
