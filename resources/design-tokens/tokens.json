{
	"$schema_version": 1,
	"name": "WC CheckoutSuite design tokens",
	"version": "1.0.0",
	"wcag_target": "2.2 AA",
	"source": "Tokens extracted from roadmap/PROTOTIPO.html and cross-checked against ROADMAP.md section 17. The prototype and the roadmap agree on every colour value; no token was invented.",
	"notes": [
		"Colours are six-digit hex with no alpha so contrast can be computed unambiguously.",
		"Both themes declare the same colour token names; a parity test enforces it.",
		"Contrast requirements reference token names rather than hex values, so changing a colour automatically re-tests every pair that uses it.",
		"The CSS custom properties in resources/design-tokens/tokens.css must match this file; a test fails when they drift."
	],
	"themes": {
		"light": {
			"color": {
				"brand": "#6d28d9",
				"brand_hover": "#5b21b6",
				"brand_subtle": "#f3edff",
				"on_brand": "#ffffff",
				"app_background": "#f6f7fb",
				"surface": "#ffffff",
				"ink": "#202334",
				"ink_muted": "#626a7b",
				"border_decorative": "#e5e7ef",
				"border_control": "#888f9f",
				"success": "#087f70",
				"warning": "#9a5b00",
				"danger": "#b42338",
				"focus_ring": "#6d28d9",
				"sidebar_surface": "#121728",
				"on_sidebar": "#e4e8f1",
				"warning_subtle": "#fff9e8",
				"warning_border": "#ead49a"
			},
			"elevation": {
				"raised": "0 12px 40px rgba(32, 35, 52, 0.07)",
				"overlay": "0 30px 90px rgba(0, 0, 0, 0.2)",
				"scrim": "rgba(18, 23, 40, 0.5)"
			}
		},
		"dark": {
			"color": {
				"brand": "#b99aff",
				"brand_hover": "#ccb5ff",
				"brand_subtle": "#302342",
				"on_brand": "#1c1030",
				"app_background": "#121521",
				"surface": "#1d2232",
				"ink": "#f0f2f8",
				"ink_muted": "#b0b8c8",
				"border_decorative": "#353d50",
				"border_control": "#7d879b",
				"success": "#6ae0c4",
				"warning": "#f0bf70",
				"danger": "#ff9baa",
				"focus_ring": "#b99aff",
				"sidebar_surface": "#0d111d",
				"on_sidebar": "#e4e8f1",
				"warning_subtle": "#3a2f14",
				"warning_border": "#6b5620"
			},
			"elevation": {
				"raised": "0 12px 40px rgba(0, 0, 0, 0.2)",
				"overlay": "0 30px 90px rgba(0, 0, 0, 0.2)",
				"scrim": "rgba(6, 8, 14, 0.6)"
			}
		}
	},
	"shared": {
		"typography": {
			"family_sans": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
			"family_mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
			"source_note": "System stack only. No web font is downloaded, so the admin never waits on a third party and no font licence is implied.",
			"size": {
				"caption": 12,
				"help": 13,
				"label": 14,
				"body_admin": 14,
				"body_checkout": 16,
				"heading_small": 15,
				"heading_medium": 19,
				"heading_large": 28
			},
			"weight": {
				"regular": 400,
				"medium": 550,
				"semibold": 650,
				"bold": 750
			},
			"line_height": {
				"body": 1.5,
				"heading": 1.2
			}
		},
		"spacing": {
			"scale": [
				4,
				8,
				12,
				16,
				24,
				32,
				48
			],
			"source_note": "Matches ROADMAP.md section 17 and the scale stated in the prototype."
		},
		"radius": {
			"control": 9,
			"field": 10,
			"row": 11,
			"panel": 14,
			"card": 16,
			"dialog": 18,
			"pill": 99
		},
		"size": {
			"field_height": 48,
			"action_height_min": 44,
			"action_height_max": 48,
			"touch_target": 44,
			"focus_outline_width": 3,
			"preview_desktop": 1280,
			"preview_tablet": 768,
			"preview_mobile": 375
		},
		"motion": {
			"fast": "0.14s",
			"base": "0.15s",
			"toast_auto_dismiss_ms": 4500,
			"reduced_motion": "prefers-reduced-motion: reduce disables transitions, animations and smooth scrolling"
		},
		"breakpoints": {
			"compact": 760,
			"narrow": 1020,
			"wide": 1550
		}
	},
	"contrast": {
		"normal_text": 4.5,
		"large_text": 3.0,
		"ui_component": 3.0,
		"note": "Thresholds are WCAG 2.2 AA. Large text is 24px, or 18.66px when bold.",
		"requirements": [
			{
				"id": "light.body.on.surface",
				"theme": "light",
				"foreground": "ink",
				"background": "surface",
				"min": 4.5,
				"usage": "Body text on panels and inputs"
			},
			{
				"id": "light.body.on.app_background",
				"theme": "light",
				"foreground": "ink",
				"background": "app_background",
				"min": 4.5,
				"usage": "Body text on the admin page background"
			},
			{
				"id": "light.help.on.surface",
				"theme": "light",
				"foreground": "ink_muted",
				"background": "surface",
				"min": 4.5,
				"usage": "Help text and secondary copy"
			},
			{
				"id": "light.help.on.app_background",
				"theme": "light",
				"foreground": "ink_muted",
				"background": "app_background",
				"min": 4.5,
				"usage": "Secondary copy outside panels"
			},
			{
				"id": "light.help.on.brand_subtle",
				"theme": "light",
				"foreground": "ink_muted",
				"background": "brand_subtle",
				"min": 4.5,
				"usage": "Help text inside a selected row"
			},
			{
				"id": "light.link.on.surface",
				"theme": "light",
				"foreground": "brand",
				"background": "surface",
				"min": 4.5,
				"usage": "Links and accent text"
			},
			{
				"id": "light.link.on.brand_subtle",
				"theme": "light",
				"foreground": "brand",
				"background": "brand_subtle",
				"min": 4.5,
				"usage": "Accent text inside a selected row"
			},
			{
				"id": "light.body.on.brand_subtle",
				"theme": "light",
				"foreground": "ink",
				"background": "brand_subtle",
				"min": 4.5,
				"usage": "Selected row text"
			},
			{
				"id": "light.button.on.brand",
