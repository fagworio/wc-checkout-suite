				"min": 4.5,
				"usage": "Links and accent text"
			},
			{
				"id": "dark.link.on.app_background",
				"theme": "dark",
				"foreground": "brand",
				"background": "app_background",
				"min": 4.5,
				"usage": "Accent text outside panels"
			},
			{
				"id": "dark.body.on.brand_subtle",
				"theme": "dark",
				"foreground": "ink",
				"background": "brand_subtle",
				"min": 4.5,
				"usage": "Selected row text"
			},
			{
				"id": "dark.link.on.brand_subtle",
				"theme": "dark",
				"foreground": "brand",
				"background": "brand_subtle",
				"min": 4.5,
				"usage": "Accent text inside a selected row"
			},
			{
				"id": "dark.button.on.brand",
				"theme": "dark",
				"foreground": "on_brand",
				"background": "brand",
