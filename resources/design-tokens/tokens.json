			},
			{
				"id": "dark.help.on.surface",
				"theme": "dark",
				"foreground": "ink_muted",
				"background": "surface",
				"min": 4.5,
				"usage": "Help text and secondary copy"
			},
			{
				"id": "dark.help.on.app_background",
				"theme": "dark",
				"foreground": "ink_muted",
				"background": "app_background",
				"min": 4.5,
				"usage": "Secondary copy outside panels"
			},
			{
